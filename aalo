          PLIST

          sudo chown root:wheel /Library/LaunchDaemons/com.macosrdp.daemon.plist
          sudo chmod 644 /Library/LaunchDaemons/com.macosrdp.daemon.plist

          sudo launchctl bootout system/com.macosrdp.daemon 2>/dev/null || true
          sudo launchctl bootstrap system /Library/LaunchDaemons/com.macosrdp.daemon.plist
          sudo launchctl kickstart -k system/com.macosrdp.daemon

      - name: Print connection information
        shell: bash
        run: |
          echo "===== TAILSCALE ====="
          tailscale status || true
          echo
          echo "===== TAILSCALE IPv4 ====="
          tailscale ip -4 || true
          echo
          echo "===== RDP LISTENER ====="
          sudo lsof -nP -iTCP:3389 -sTCP:LISTEN || true
          echo
          echo "Connect from Windows Remote Desktop to:"
          echo "  <TAILSCALE-IP>:3389"
          echo
          echo "KEEP THIS GITHUB ACTION RUNNING."

      - name: Keep session alive
        shell: bash
        run: |
          echo "Remote macOS session is active."
          echo "The job will remain alive until the workflow is cancelled or GitHub's job limit is reached."
          sleep 21600
