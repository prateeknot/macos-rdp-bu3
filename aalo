              <string>/usr/local/sbin/macos-rdp-daemon</string>
              <string>--port</string>
              <string>3389</string>
            </array>

            <key>RunAtLoad</key>
            <true/>

            <key>KeepAlive</key>
            <true/>

            <key>StandardOutPath</key>
            <string>/var/log/macos-rdp-daemon.out.log</string>

            <key>StandardErrorPath</key>
            <string>/var/log/macos-rdp-daemon.error.log</string>
          </dict>
